{
  "manifest_version": 3,
  "name": "AWS Gzipped JSON Formatter",
  "version": "1.1.0",
  "description": "Format and preview gzipped JSON payloads in DynamoDB and S3",
  "permissions": [
    "contextMenus",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://*.console.aws.amazon.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.console.aws.amazon.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AWS Gzipped JSON Formatter"
  },
  "icons": {
    "16": "icons/gzip-json-water-16.png",
    "48": "icons/gzip-json-water-48.png",
    "128": "icons/gzip-json-water-128.png"
  }
}